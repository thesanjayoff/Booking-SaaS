# ---- Required ----
# Long random string (>= 32 chars). Signs sessions and cancel/reschedule links, encrypts Google tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Password for /admin (single owner)
ADMIN_PASSWORD=change-me
# Public base URL used in emails and OAuth redirects
APP_URL=http://localhost:3000

# ---- Database ----
DATABASE_PATH=./data/app.db

# ---- Behind a reverse proxy? set to 1 so rate limiting trusts X-Forwarded-For ----
TRUST_PROXY=0

# ---- Background worker (reminders, Google sync) runs inside the Next server by default ----
RUN_WORKER=1

# ---- Email (SMTP). Leave SMTP_HOST empty to log emails to data/outbox instead ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sunrise Family Clinic <bookings@example.com>"
OWNER_NOTIFY_EMAIL=

# ---- SMS via Twilio (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# ---- WhatsApp via Meta Cloud API (optional) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=appointment_reminder

# ---- Payments: Razorpay deposits (OFF by default) ----
PAYMENTS_ENABLED=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Google Calendar two-way sync (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
